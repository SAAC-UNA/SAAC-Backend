# ========================================
# LDAP Seed Data - SAAC Backend
# ========================================
# Este archivo contiene los usuarios REALES del proyecto
# Coinciden con los usuarios definidos en database/seeders/UserSeeder.php
#
# Estructura:
#   dc=una,dc=local
#   └── ou=users
#       ├── ou=profesores
#       │   ├── uid=203849675 (Pablo Castillo - Superusuario)
#       │   └── uid=203948609 (Cristopher Montero - Administrador)
#       └── ou=estudiantes
#           ├── uid=801490957 (Naydelin Jiron)
#           ├── uid=208330811 (Jose Jara)
#           ├── uid=118620669 (Marisol Hidalgo)
#           ├── uid=207800171 (Ian Villegas)
#           └── uid=206870079 (Ana Zuniga)
#
# CONTRASEÑA TEMPORAL: una2024 (para TODOS los usuarios en desarrollo)
#
# Para importar estos datos:
#   docker cp ldap-seed.ldif saac_openldap:/tmp/seed.ldif
#   docker exec saac_openldap ldapadd -x -D "cn=admin,dc=una,dc=local" -w admin -f /tmp/seed.ldif
#
# Para verificar datos importados:
#   docker exec saac_openldap ldapsearch -x -b "dc=una,dc=local" -LLL
# ========================================

# ========================================
# Unidad Organizativa: users
# ========================================
# Contenedor principal para todos los usuarios del sistema
dn: ou=users,dc=una,dc=local
objectClass: organizationalUnit
objectClass: top
ou: users
description: Usuarios del Sistema SAAC

# ========================================
# Unidad Organizativa: profesores
# ========================================
# Contenedor para usuarios con rol de profesor/docente
dn: ou=profesores,ou=users,dc=una,dc=local
objectClass: organizationalUnit
objectClass: top
ou: profesores
description: Profesores y docentes de la UNA

# ========================================
# Unidad Organizativa: estudiantes
# ========================================
# Contenedor para usuarios con rol de estudiante
dn: ou=estudiantes,ou=users,dc=una,dc=local
objectClass: organizationalUnit
objectClass: top
ou: estudiantes
description: Estudiantes de la UNA

