# Copia este archivo a .env.testing y ajusta los valores a tu entorno local.
# .env.testing es ignorado por git — cada desarrollador tiene el suyo.
#
# phpunit.xml ya define:
#   APP_ENV=testing
#   DB_CONNECTION=mysql
#   DB_DATABASE=saac_testing
#
# Solo necesitas sobreescribir lo que difiere de tu .env principal:

DB_HOST=127.0.0.1
DB_PORT=3307          # Cambia si tu MySQL corre en otro puerto (p.ej. 3306 sin Docker)
DB_USERNAME=root
DB_PASSWORD=root

# La base de datos de testing debe existir antes de correr los tests:
# docker exec saac_mysql mysql -u root -proot -e "CREATE DATABASE IF NOT EXISTS saac_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
