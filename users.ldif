# Archivo LDIF para importar usuarios del proyecto SAAC
# Base DN: dc=una,dc=local
# 
# Instrucciones de uso:
# 1. Copiar al contenedor: docker cp users.ldif saac_ldap:/tmp/users.ldif
# 2. Importar: docker exec saac_ldap ldapadd -x -D "cn=admin,dc=una,dc=local" -w admin -f /tmp/users.ldif

# Unidad Organizacional para usuarios
dn: ou=users,dc=una,dc=local
objectClass: organizationalUnit
ou: users

# Unidad Organizacional para profesores
dn: ou=profesores,ou=users,dc=una,dc=local
objectClass: organizationalUnit
ou: profesores

# Unidad Organizacional para estudiantes
dn: ou=estudiantes,ou=users,dc=una,dc=local
objectClass: organizationalUnit
ou: estudiantes

# ============================================
# PROFESORES
# ============================================
# (vacío - sin profesores en el sistema)

