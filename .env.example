APP_NAME=SAAC-UNA
APP_ENV=local
APP_KEY=base64:CHANGE_ME_WITH_ARTISAN_KEY
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# Database
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saac_db
DB_USERNAME=saac_user
DB_PASSWORD=saac_password

# ============================================
# Redis (optional)
# ============================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# LDAP
# ============================================
# Local development (OpenLDAP in Docker)
LDAP_ENABLED=true
LDAP_HOST=localhost
LDAP_PORT=636
LDAP_BASE_DN=dc=example,dc=org
LDAP_USERNAME=cn=admin,dc=example,dc=org
LDAP_PASSWORD=change_me
LDAP_USE_SSL=true
LDAP_SSL_VERIFY=false
LDAP_USE_TLS=false
LDAP_TIMEOUT=5

# Production/testing example
# LDAP_ENABLED=true
# LDAP_HOST=ldap.example.org
# LDAP_PORT=389
# LDAP_BASE_DN=dc=example,dc=org
# LDAP_USERNAME=cn=readonly,dc=example,dc=org
# LDAP_PASSWORD=change_me
# LDAP_USE_SSL=false
# LDAP_USE_TLS=true
# LDAP_TIMEOUT=10

# ============================================
# Sessions and cache
# ============================================
# Options: file, cookie, database, redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Options: file, database, redis
CACHE_STORE=file

# ============================================
# Storage system
# ============================================
FILESYSTEM_DISK=simulated_nas
QUEUE_CONNECTION=sync
DB_QUEUE_RETRY_AFTER=30
BROADCAST_CONNECTION=log

# ============================================
# NAS config (production)
# ============================================
# FILESYSTEM_DISK=production_nas
# NAS_HOST=10.0.0.50
# NAS_USERNAME=saac_user
# NAS_PASSWORD=secure_password
# NAS_PORT=22
# NAS_ROOT=/mnt/data/saac

# ============================================
# Email
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
