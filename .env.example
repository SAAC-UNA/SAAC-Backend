APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# Base de Datos
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=saac
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# Redis (para sesiones y cache)
# ============================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# LDAP (Autenticación de la Universidad)
# ============================================
# Desarrollo local (OpenLDAP en Docker con LDAPS)
# LDAP DESACTIVADO - PENDIENTE DE IMPLEMENTACIÓN
LDAP_ENABLED=false
LDAP_HOST=localhost
LDAP_PORT=636
LDAP_BASE_DN=dc=una,dc=local
LDAP_USERNAME=cn=admin,dc=una,dc=local
LDAP_PASSWORD=admin
LDAP_USE_SSL=true
LDAP_SSL_VERIFY=false
LDAP_USE_TLS=false
LDAP_TIMEOUT=5

# Producción/Testing (LDAP de la Universidad)
# Descomentar cuando se tenga acceso al servidor LDAP de la UNA
# LDAP_ENABLED=true
# LDAP_HOST=ldap.una.ac.cr
# LDAP_PORT=636
# LDAP_BASE_DN=dc=una,dc=ac,dc=cr
# LDAP_USERNAME=cn=readonly,dc=una,dc=ac,dc=cr
# LDAP_PASSWORD=contraseña_proporcionada_por_ti
# LDAP_USE_SSL=true
# LDAP_SSL_VERIFY=true
# LDAP_USE_TLS=false
# LDAP_TIMEOUT=10

# ============================================
# Sesiones y Cache
# ============================================
# Opciones: file, cookie, database, redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Seguridad de cookies (httpOnly protege contra XSS)
SESSION_HTTP_ONLY=true
# En producción con HTTPS, cambiar a true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Opciones: file, database, redis
CACHE_STORE=database

# ============================================
# Sistema de Almacenamiento
# ============================================
FILESYSTEM_DISK=simulated_nas
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ============================================
# Configuración NAS (para producción)
# ============================================
# Descomentar y configurar cuando el NAS de la universidad esté disponible
# FILESYSTEM_DISK=production_nas
# NAS_HOST=10.0.0.50
# NAS_USERNAME=saac_user
# NAS_PASSWORD=secure_password
# NAS_PORT=22
# NAS_ROOT=/mnt/data/saac

# ============================================
# Email - HU-016: Notificaciones de Solicitudes
# ============================================
# Desarrollo: Usar 'log' (emails se guardan en storage/logs/laravel.log)
# Producción: Usar 'smtp' y configurar credenciales reales

# Desarrollo (Local)
MAIL_MAILER=log
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@saac.una.ac.cr"
MAIL_FROM_NAME="Sistema SAAC - UNA"

# ============================================
# Configuración SMTP Gmail
# ============================================
# Para enviar correos reales con Gmail:
# 1. Habilitar verificación en 2 pasos: https://myaccount.google.com/security
# 2. Crear App Password: https://myaccount.google.com/apppasswords
#    - Seleccionar "Correo" y "Otro dispositivo"
#    - Copiar la contraseña de 16 caracteres (sin espacios)
# 3. Descomentar y configurar:
#
# MAIL_MAILER=smtp
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-char-app-password-here
# MAIL_FROM_ADDRESS="your-email@gmail.com"

# ============================================
# Configuración SMTP Servidor UNA (Producción)
# ============================================
# Descomentar cuando se despliegue en producción
# Solicitar credenciales a IT de la UNA
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.una.ac.cr
# MAIL_PORT=587
# MAIL_USERNAME=saac@una.ac.cr
# MAIL_PASSWORD=request-from-IT-department
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="saac@una.ac.cr"
# MAIL_FROM_NAME="Sistema SAAC - UNA"

# Producción (Servidor UNA) - Descomentar y configurar cuando se despliegue
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.una.ac.cr
# MAIL_PORT=587
# MAIL_USERNAME=saac@una.ac.cr
# MAIL_PASSWORD=*** (solicitar a IT de la UNA)
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="saac@una.ac.cr"
# MAIL_FROM_NAME="Sistema SAAC - UNA"

# Pruebas con Gmail (Opcional) - Crear App Password en https://myaccount.google.com/apppasswords
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-email@gmail.com
# MAIL_PASSWORD=abcd-efgh-ijkl-mnop
# MAIL_ENCRYPTION=tls

# ============================================
# Frontend
# ============================================
VITE_APP_NAME="${APP_NAME}"

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# En desarrollo se permite cualquier origen (*)
# En producción especificar los dominios permitidos separados por coma
# Ejemplo: CORS_ALLOWED_ORIGINS=https://saac.una.cr,https://www.saac.una.cr
CORS_ALLOWED_ORIGINS=https://saac.una.cr
